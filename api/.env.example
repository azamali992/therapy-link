# Copy to .env. All variables are prefixed TL_.
# dev | staging | prod. In staging/prod, or with any non-sqlite database, the API refuses to
# start while either TL_DEV_* switch below is on.
TL_ENV=dev
TL_DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Postgres (Neon): TL_DATABASE_URL=postgresql+asyncpg://user:pass@host/db?ssl=require
# true behind a transaction-mode pooler (Neon's -pooler host, PgBouncer); empty guesses from the URL.
TL_DATABASE_POOLED=
TL_FIREBASE_PROJECT_ID=therapylink69
# Path to a service-account JSON, never committed. Sign-in works without it; DELETE /me needs it
# to remove the Firebase account (or ADC, on hosts that provide them, like Cloud Run). Set it in prod.
TL_FIREBASE_SERVICE_ACCOUNT_JSON=
# OpenAI-compatible llama-server (the Eve server). Setting the URL requires the key too: start
# llama-server with --api-key and put the same value here.
TL_INFERENCE_BASE_URL=
TL_INFERENCE_API_KEY=
TL_INFERENCE_MODEL=eve-e4b
# Hard cap on tokens the server forwards to the LLM per request.
TL_INFERENCE_MAX_TOKENS=1024
# Cloud chat per uid: a burst of CAPACITY requests, refilled evenly over PERIOD_S seconds.
TL_INFERENCE_RATE_CAPACITY=30
TL_INFERENCE_RATE_PERIOD_S=600
# Hard daily cap on cloud chat per uid, across all short windows.
TL_INFERENCE_DAILY_CAP=300
# Mutating routes (POST/PUT/PATCH/DELETE) per uid: this many per minute.
TL_WRITE_RATE_CAPACITY=60
# Redis URL for shared rate-limit state across workers. Leave empty for in-memory (per-worker).
TL_REDIS_URL=
# When true, POST/PATCH/PUT/DELETE and /inference/chat require a valid Firebase App Check token
# in the X-Firebase-AppCheck header. Keep false in dev/staging until app is enrolled.
TL_APP_CHECK_REQUIRED=false
# SHA-256 hex digest of the expected system prompt. When set, /inference/chat rejects any request
# whose system message does not hash to this value. Leave empty to accept any prompt.
TL_PROMPT_SHA256=
TL_CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]
# Local development only: authenticate with an X-Dev-Uid header instead of a Firebase token.
TL_DEV_AUTH_BYPASS=false
# Local demos only: approve clinician sign-ups instantly.
TL_DEV_AUTO_VERIFY_CLINICIANS=false
# Secret mixed into uid hashes in structured logs. Must differ from the default in prod/staging.
TL_LOG_UID_SALT=dev-salt-change-me
