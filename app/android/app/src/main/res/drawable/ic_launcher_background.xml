<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background: the Jugnu ground, night #1D1E2C at the top to plum #34063F at the
    bottom. The ramp spans only the visible 72 dp (y 18 to 90 of the 108 dp layer) and is clamped
    outside it, so the launcher shows the same ramp as the square master icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="90"
                android:startColor="#FF1D1E2C"
                android:endColor="#FF34063F"
                android:tileMode="clamp" />
        </aapt:attr>
    </path>
</vector>
