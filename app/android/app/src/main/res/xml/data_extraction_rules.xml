<?xml version="1.0" encoding="utf-8"?>
<!--
    Excludes everything from Android cloud backup and device-to-device transfer.
    TherapyLink stores sessions, journals and check-ins in SQLCipher (encrypted);
    the raw key is in EncryptedSharedPreferences. Backing up either without the key
    would produce unusable data, and backing up the key separately would be a privacy
    risk. Users who want a copy of their data use the in-app export instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
