# ops/free/.env: read by docker compose (variable interpolation) and by setup.sh, backup.sh and
# healthcheck.sh. setup.sh copies this file to .env, fills the secrets with random values and sets
# it to mode 600. Never commit .env (the root .gitignore already ignores it).

# --- which services run ------------------------------------------------------------------------
# caddy    TLS on this VM with a Let's Encrypt certificate (needs ports 80/443 open). Default.
# tunnel   Cloudflare Tunnel instead of caddy: no open ports, needs a domain on Cloudflare and
#          CLOUDFLARE_TUNNEL_TOKEN. Cloudflare terminates TLS, so it sees request bodies (chat text).
# localdb  Postgres on this VM. Leave it out and set TL_DATABASE_URL to use Neon instead.
COMPOSE_PROFILES=caddy,localdb
COMPOSE_PROJECT_NAME=therapylink

# --- public address ----------------------------------------------------------------------------
# A name whose A record points at the VM's public IP: your own domain, or a free one such as
# <name>.duckdns.org. The app is built with --dart-define=TL_API_URL=https://$TL_DOMAIN
TL_DOMAIN=
ACME_EMAIL=
CLOUDFLARE_TUNNEL_TOKEN=

# --- environment -------------------------------------------------------------------------------
# One value for the API and Eve. staging: real Firebase, real users allowed, the dev bypasses are
# refused. prod: also refuses to serve any adapter without a clinician's name in ml/registry.json
# (v16c-e2 has none yet, so Eve will not start under prod until it is signed off).
TL_ENV=staging
# 1 lets Eve serve the `candidate` adapter on staging. Ignored (refused) when TL_ENV=prod.
TL_LLM_ALLOW_UNAPPROVED=1

# --- secrets (setup.sh generates these when empty) ---------------------------------------------
# Shared by the API (as TL_INFERENCE_API_KEY) and llama-server. >= 24 characters.
TL_LLM_API_KEY=
POSTGRES_PASSWORD=
TL_LOG_UID_SALT=

# --- database ----------------------------------------------------------------------------------
# Empty: the local Postgres container (profile localdb).
# Neon instead: postgresql+asyncpg://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?ssl=require
# and remove localdb from COMPOSE_PROFILES.
TL_DATABASE_URL=

# --- Firebase ----------------------------------------------------------------------------------
TL_FIREBASE_PROJECT_ID=therapylink69
# Host path of the service-account JSON (chmod 600, never in git). Needed for DELETE /me to remove
# the Firebase account. Leave empty to skip; sign-in works without it.
FIREBASE_SA_JSON_HOST_PATH=
# true once the release app is enrolled in App Check.
TL_APP_CHECK_REQUIRED=false

# --- Eve on CPU --------------------------------------------------------------------------------
EVE_MODELS_DIR=/srv/eve/models
# Threads = physical cores. Empty: setup.sh sets the VM's core count (2 on the Always Free A1).
EVE_THREADS=
# Parallel slots. Two replies at once share the same cores, so each is half as fast; 2 lets a short
# reply overtake a long one instead of waiting behind it.
EVE_SLOTS=2
EVE_CTX_PER_SLOT=8192
# Host-RAM prompt cache (llama.cpp --cache-ram), so a returning conversation doesn't re-read its
# whole history on CPU. llama.cpp's default is 8192 MiB, too much for a 12 GB VM.
EVE_CACHE_RAM_MIB=1536
EVE_MEM_LIMIT=7g

# Model downloads (setup.sh / get-models.sh). The base is the public unsloth GGUF on Hugging Face,
# whose sha256 matches ml/registry.json (checked 2026-10-03). The adapter is ours and private: give
# a time-limited URL (an OCI Object Storage pre-authenticated request, or a private HF repo URL with
# EVE_HF_TOKEN), or copy the file to the VM and set EVE_ADAPTER_PATH.
EVE_BASE_URL=https://huggingface.co/unsloth/gemma-4-E2B-it-GGUF/resolve/main/gemma-4-E2B-it-Q4_K_M.gguf
EVE_ADAPTER_URL=
EVE_ADAPTER_PATH=
EVE_HF_TOKEN=

# --- API rate limits (defaults from api/README.md) --------------------------------------------
TL_INFERENCE_RATE_CAPACITY=30
TL_INFERENCE_RATE_PERIOD_S=600
TL_INFERENCE_DAILY_CAP=300

# --- backups (backup.sh) -----------------------------------------------------------------------
# age public key (age1...). The private key stays OFF this VM (password manager / offline).
# backup.sh refuses to run without it: no unencrypted health data leaves the box.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/therapylink
BACKUP_KEEP_LOCAL=7
BACKUP_KEEP_REMOTE_DAYS=30
# rclone remote "tlbackup" from environment variables. OCI Object Storage (S3 compatibility API,
# Customer Secret Key) shown; for Cloudflare R2 use PROVIDER=Cloudflare and the R2 endpoint.
# Leave BACKUP_REMOTE_PATH empty to keep backups on the VM only.
BACKUP_REMOTE_PATH=
RCLONE_CONFIG_TLBACKUP_TYPE=s3
RCLONE_CONFIG_TLBACKUP_PROVIDER=Other
RCLONE_CONFIG_TLBACKUP_ENDPOINT=
RCLONE_CONFIG_TLBACKUP_REGION=
RCLONE_CONFIG_TLBACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_TLBACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_TLBACKUP_FORCE_PATH_STYLE=true
RCLONE_CONFIG_TLBACKUP_NO_CHECK_BUCKET=true

# --- monitoring (healthcheck.sh, backup.sh) ----------------------------------------------------
# healthchecks.io ping URLs (free plan). Empty: the scripts only log locally.
HC_PING_URL=
HC_BACKUP_PING_URL=
